# Public application configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only
SUPABASE_SERVICE_ROLE_KEY=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# off | redirect | live. Keep redirect/off until a custom domain is verified.
EMAIL_DELIVERY_MODE=off

# Mux Video — server-only
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
# Base64-encoded PEM private key returned once when creating the signing key.
MUX_SIGNING_PRIVATE_KEY=
# Optional: Mux Playback Restriction ID for referrer/user-agent restrictions.
MUX_PLAYBACK_RESTRICTION_ID=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Whop legacy integration
WHOP_API_KEY=
WHOP_PRODUCT_ID=
WHOP_WEBHOOK_SECRET=

# 32 random bytes encoded as base64. Used to encrypt integration credentials.
ENCRYPTION_KEY=

# Playwright E2E — local/CI test accounts only
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
E2E_NOACCESS_EMAIL=
E2E_NOACCESS_PASSWORD=
