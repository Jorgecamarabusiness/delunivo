# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Identidad legal pública. Obligatoria antes de aceptar clientes o pagos reales.
LEGAL_NAME=
LEGAL_TAX_ID=
LEGAL_ADDRESS=
LEGAL_CONTACT_EMAIL=

# Supabase (use a non-production project for local and CI tests)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Los E2E rechazan explícitamente el project ref de producción.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
E2E_NOACCESS_EMAIL=
E2E_NOACCESS_PASSWORD=
# 32 bytes aleatorios en base64. Cifra la sesión original durante Run as.
IMPERSONATION_SESSION_KEY=

# Mux Video — server-only; never add NEXT_PUBLIC_ to these names
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=
# En local y tests evita tocar recursos reales; producción lo omite para procesar la cola.
MUX_DELETION_MODE=off

# Solo producción: Vercel lo envía como Bearer al cron de limpieza de Mux.
CRON_SECRET=

# Existing integrations
# Local/Preview: redirect (default), live u off. En Vercel Production se activa
# live automáticamente cuando RESEND_FROM_EMAIL está configurado.
EMAIL_DELIVERY_MODE=redirect
RESEND_API_KEY=
# Obligatorio para producción: dirección de un dominio verificado en Resend.
RESEND_FROM_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
